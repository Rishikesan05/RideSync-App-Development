rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: any authenticated user can read (dashboard is already guarded by ProtectedRoute).
    // Admin can write and delete. Own profile can update itself.
    match /users/{uid} {
      allow read:   if request.auth != null;
      allow create: if request.auth != null;
      allow update: if request.auth != null && request.auth.uid == uid;
      allow write, delete: if isAdminUser();
    }

    // Passengers profiles
    match /passengers/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
      allow write, delete: if isAdminUser();
    }

    // Operators profiles — public read so schedule form can validate operatorId.
    // Admins can update/delete for Users Management.
    match /operators/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
      allow write, delete: if isAdminUser();
    }

    // LEGACY: 'operator' (singular) — kept for backward compatibility only.
    match /operator/{uid} {
      allow read: if true;
      allow write: if isAdminUser();
    }

    // Admin collection
    match /admin/{uid} {
      allow read: if request.auth != null;
      allow write: if isAdminUser();
    }

    // ── Helpers ─────────────────────────────────────────────────────────────
    // isAdminUser: checks the /users/{uid} doc for role === 'admin'.
    // Used only for write/delete guards (NOT in collection-query read rules).
    function isAdminUser() {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == 'admin';
    }

    // Legacy hasRole helper kept for backwards-compat with other rules below.
    function hasRole(role) {
      return request.auth != null &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '') == role;
    }

    // Routes: public read, admin write
    match /routes/{routeId} {
      allow read: if true;
      allow write: if hasRole('admin');
    }

    // Buses: public read, admin write
    match /buses/{busId} {
      allow read: if true;
      allow write: if hasRole('admin');
    }

    // Fares: public read, admin write
    match /fares/{fareId} {
      allow read: if true;
      allow write: if hasRole('admin');
    }

    // Bookings: passenger reads/writes own, operator reads own schedule, admin reads all
    match /bookings/{bookingId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.passengerId
                  || hasRole('operator') || hasRole('admin'));
      allow create: if request.auth != null && (hasRole('passenger') || request.auth.token.role == 'passenger');
      allow update: if request.auth != null && (request.auth.uid == resource.data.passengerId
                    || hasRole('admin'));
    }

    // Feedback: passenger creates own, admin reads
    match /feedback/{feedbackId} {
      allow create: if hasRole('passenger');
      allow read: if hasRole('admin');
    }

    // Notifications: user reads/writes own only
    match /notifications/{uid}/items/{notifId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Schedules and Seats: Public read for search, secure write/update
    match /schedules/{scheduleId} {
      allow read: if true;
      allow create, delete: if hasRole('admin');
      // The schedule stores operatorId as a custom string (e.g. RSOP26-001), NOT the
      // Firebase Auth UID. We resolve the operator's profile by uid and compare the
      // operatorId field stored there against the one on the schedule document.
      allow update: if hasRole('admin')
                    || (hasRole('operator') &&
                        get(/databases/$(database)/documents/operators/$(request.auth.uid))
                          .data.get('operatorId', '') == resource.data.operatorId);

      match /seats/{seatId} {
        allow read: if true;
        allow write, update: if request.auth != null;
      }
    }
  }
}
