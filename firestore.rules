rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Users ──────────────────────────────────────────────────────────
    // • Any authenticated user can create their own profile (registration).
    // • Users can read and update their own profile only.
    // • admin_pending users can read their own profile to check their status.
    // • Admins can READ all user documents (to list pending admins).
    // • Admins can UPDATE any user's role/updatedAt (the approval action).
    match /users/{uid} {
      allow create: if request.auth != null;

      // Own profile: full read + update (but not delete)
      allow read, update: if request.auth != null && request.auth.uid == uid;

      // Admin: read ALL users (e.g. list admin_pending users for approval)
      allow read: if isAdmin();

      // Admin: update ANY user's role field (approve/reject admin_pending)
      // Restricted to only the fields that the approval flow needs to touch.
      allow update: if isAdmin()
                    && request.resource.data.diff(resource.data).affectedKeys()
                       .hasOnly(['role', 'updatedAt']);
    }

    // Passengers profiles
    match /passengers/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read: if request.auth != null && request.auth.token.role == 'admin';
    }

    // Operators profiles
    match /operators/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, write: if request.auth != null && request.auth.token.role == 'admin';
    }

    // isAdmin: checks JWT custom claim first (fast, no extra read),
    // then falls back to the Firestore /users doc role field.
    // Custom claims are set by create-demo-user.js and auth.setCustomUserClaims().
    function isAdmin() {
      return request.auth != null && (
        request.auth.token.role == 'admin' ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin'
      );
    }

    // hasRole: generic role check — JWT claim first, Firestore doc fallback.
    function hasRole(role) {
      return request.auth != null && (
        request.auth.token.role == role ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == role
      );
    }

    // Routes: public read, admin write
    match /routes/{routeId} {
      allow read: if true;
      allow write: if hasRole('admin');
    }

    // Buses: public read, admin write
    match /buses/{busId} {
      allow read: if true;
      allow write: if hasRole('admin');
    }

    // Fares: public read, admin write
    match /fares/{fareId} {
      allow read: if true;
      allow write: if hasRole('admin');
    }

    // Bookings: passenger reads/writes own, operator reads own schedule, admin reads all
    match /bookings/{bookingId} {
      allow read: if request.auth != null && (request.auth.uid == resource.data.passengerId
                  || hasRole('operator') || hasRole('admin'));
      allow create: if request.auth != null && (hasRole('passenger') || request.auth.token.role == 'passenger');
      allow update: if request.auth != null && (request.auth.uid == resource.data.passengerId
                    || hasRole('admin'));
    }

    // Feedback: passenger creates own, admin reads
    match /feedback/{feedbackId} {
      allow create: if hasRole('passenger');
      allow read: if hasRole('admin');
    }

    // Notifications: user reads/writes own only
    match /notifications/{uid}/items/{notifId} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Schedules and Seats: Public read for search, secure write/update
    match /schedules/{scheduleId} {
      allow read: if true;
      allow create, delete: if hasRole('admin');
      allow update: if hasRole('admin') 
                    || (hasRole('operator') && request.auth.token.busId == resource.data.busId);

      match /seats/{seatId} {
        allow read: if true;
        allow write, update: if request.auth != null;
      }
    }
  }
}
