# ── Firebase ─────────────────────────────────────────────────────────────────
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-app-id"
VITE_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# ── Firebase Realtime Database ────────────────────────────────────────────────
# Required for live GPS bus tracking on the admin dashboard.
# Format: https://<project-id>-default-rtdb.<region>.firebasedatabase.app
VITE_FIREBASE_DATABASE_URL="https://your-project-default-rtdb.region.firebasedatabase.app"

# ── Google Maps ───────────────────────────────────────────────────────────────
# Required for the Route Builder: map display, Places Autocomplete, and Directions.
# 1. Go to https://console.cloud.google.com/apis/library
# 2. Enable ALL THREE APIs:
#    - Maps JavaScript API
#    - Places API
#    - Directions API
# 3. Copy the API key from https://console.cloud.google.com/apis/credentials
# ⚠  Without this key the Route Builder map, start/end point autocomplete, and
#    distance calculation will NOT work.
VITE_GOOGLE_MAPS_API_KEY="your-google-maps-api-key"

# ── Backend API URL ───────────────────────────────────────────────────────────
# Default (production): leave this commented out — axios.js falls back to Cloud Functions URL
# Uncomment ONLY when running: firebase emulators:start --only functions
# VITE_API_BASE_URL=http://127.0.0.1:5001/your-project-id/asia-south1/api/api
